@{
    ViewData["Title"] = "Emergency SOS";
}

@section Styles {
    <!-- Leaflet Map & Routing CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.css" />

    <style>
        .sos-container {
            max-width: 650px;
            margin: 0 auto;
        }

        .sos-card {
            background: #ffffff;
            border-radius: 24px;
            border: 3px solid #ffccd5;
            box-shadow: 0 12px 30px rgba(255, 77, 109, 0.2);
            padding: 24px;
        }

        #mapContainer {
            width: 100%;
            height: 380px;
            border-radius: 18px;
            border: 2.5px solid #ff4d6d;
            box-shadow: 0 4px 15px rgba(255, 77, 109, 0.15);
            z-index: 1;
        }

        .leaflet-routing-container {
            display: none !important;
        }

        .support-card {
            border-radius: 16px;
            border-left: 6px solid #ff4d6d;
            background: #fff0f3;
        }

        .badge-free {
            background-color: #ff4d6d;
            font-size: 0.85rem;
            padding: 6px 12px;
            border-radius: 20px;
        }
    </style>
}

@Html.AntiForgeryToken()

<div class="container sos-container my-3">
    <div class="sos-card text-center">

        <h1 class="fw-bold text-danger mb-1">🚨 Emergency SOS</h1>
        <p class="fs-5 fw-bold text-dark mb-1">Take a deep breath. You're safe 💕</p>
        <p class="text-muted small mb-3">Showing nearest verified public health clinics with free emergency pads:</p>

        <div id="locationStatus" class="alert alert-light border-pink text-danger fw-bold py-2 mb-3">
            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            Detecting your current location...
        </div>

        <div id="mapContainer" class="my-3"></div>

        <div id="supportPointsSection" class="mt-4 text-start">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold text-dark mb-0">📍 Verified Nearby Clinics</h4>
                <span id="spotCountBadge" class="badge bg-success">Ready Now</span>
            </div>

            <div id="supportPointsList">
                <div class="text-center py-3 text-muted">
                    <span class="spinner-border spinner-border-sm me-2"></span> Calculating nearest verified clinics to your location...
                </div>
            </div>
        </div>

        <hr class="my-4" style="border-color: #ffd1dc;" />

        <div class="bg-light p-3 rounded-3">
            <p class="fw-bold text-danger mb-1 small">Need someone to talk to or extra assistance?</p>
            <a href="tel:0800123456" class="btn btn-outline-danger btn-sm rounded-pill fw-bold w-100">
                📞 Call Free Helpline: 0800 123 456
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.js"></script>

    <script>
        let map = null;
        let routingControl = null;
        let markersGroup = null;

        // Fallback default coordinates (Durban / eThekwini Area)
        let userLat = -29.8587;
        let userLng = 31.0218;

        // VERIFIED REAL PUBLIC CLINICS & HEALTH CENTERS
        const VERIFIED_CLINICS = [
            {
                name: "KwaDabeka Community Health Centre",
                type: "Public Community Health Centre",
                details: "Main Pharmacy & Emergency Youth Clinic",
                stock: "Free Emergency Pad Dispenser & Sanitary Kits",
                lat: -29.8021,
                lng: 30.8654
            },
            {
                name: "Pinetown Primary Clinic",
                type: "Municipal Primary Clinic",
                details: "Ground Floor Restrooms & Consultation Wing",
                stock: "Free Sanitary Towels Available at Reception",
                lat: -29.8160,
                lng: 30.8530
            },
            {
                name: "Clernaville Clinic",
                type: "Public Health Facility",
                details: "Maternal & Women's Health Section",
                stock: "Free Emergency Hygiene Packs",
                lat: -29.8115,
                lng: 30.8872
            },
            {
                name: "Westville Campus Health Clinic (UKZN)",
                type: "Campus Wellness Centre",
                details: "Student Care Centre, Building M",
                stock: "Free Pad Cabinet & Emergency Care Packs",
                lat: -29.8178,
                lng: 30.9427
            },
            {
                name: "Addington Primary Healthcare Clinic",
                type: "Provincial Health Facility",
                details: "Outpatient Clinic & Wellness Hub",
                stock: "Free Government Supply Sanitary Towels",
                lat: -29.8601,
                lng: 31.0410
            },
            {
                name: "DUT Student Health Services (Steve Biko)",
                type: "Campus Health Clinic",
                details: "Student Counselling & Health Services Centre",
                stock: "Free Period Products Box (No code required)",
                lat: -29.8516,
                lng: 31.0084
            }
        ];

        window.addEventListener('DOMContentLoaded', () => {
            initMapWithGPS();
        });

        function initMapWithGPS() {
            const statusDiv = document.getElementById('locationStatus');

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        userLat = position.coords.latitude;
                        userLng = position.coords.longitude;

                        statusDiv.className = 'alert alert-success py-2 mb-3 fw-bold';
                        statusDiv.innerHTML = `📍 Live location found! Distance to verified clinics updated.`;

                        loadMapAndCalculatedSpots();
                    },
                    (error) => {
                        statusDiv.className = 'alert alert-warning py-2 mb-3 small';
                        statusDiv.innerHTML = `⚠️ Using general area map (Enable GPS for precise walking distance).`;
                        loadMapAndCalculatedSpots();
                    },
                    { timeout: 8000, enableHighAccuracy: true }
                );
            } else {
                statusDiv.className = 'alert alert-warning py-2 mb-3 small';
                statusDiv.innerHTML = `⚠️ Using general area map.`;
                loadMapAndCalculatedSpots();
            }
        }

        function loadMapAndCalculatedSpots() {
            if (!map) {
                map = L.map('mapContainer').setView([userLat, userLng], 14);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '© OpenStreetMap'
                }).addTo(map);

                markersGroup = L.layerGroup().addTo(map);
            } else {
                map.setView([userLat, userLng], 14);
                markersGroup.clearLayers();
            }

            // User Location Marker
            L.marker([userLat, userLng])
                .addTo(map)
                .bindPopup("<b>📍 You are here</b>")
                .openPopup();

            // Calculate exact distances from user's actual GPS location
            const sortedSpots = VERIFIED_CLINICS.map(clinic => {
                const distMeters = calculateDistanceMeters(userLat, userLng, clinic.lat, clinic.lng);
                const walkMins = Math.max(1, Math.round(distMeters / 80)); // ~80m per min walk

                return {
                    ...clinic,
                    distanceMeters: distMeters,
                    distanceText: distMeters > 1000 ? `${(distMeters / 1000).toFixed(1)} km away` : `${Math.round(distMeters)}m away`,
                    walkTime: `${walkMins} min walk`
                };
            }).sort((a, b) => a.distanceMeters - b.distanceMeters);

            document.getElementById('spotCountBadge').innerText = `${sortedSpots.length} Verified`;

            // Plot markers on map
            sortedSpots.forEach(spot => {
                const marker = L.marker([spot.lat, spot.lng]).addTo(markersGroup);
                marker.bindPopup(`
                    <b>🌸 ${escapeHtml(spot.name)}</b><br>
                    <small>🏥 ${escapeHtml(spot.type)}</small><br>
                    ${escapeHtml(spot.stock)}<br>
                    <small>🏃‍♀️ ${spot.walkTime} (${spot.distanceText})</small><br>
                    <button class="btn btn-xs btn-danger mt-1 text-white" onclick="drawOnScreenRoute('${escapeHtml(spot.name)}', ${spot.lat}, ${spot.lng})">
                        Show Route
                    </button>
                `);
            });

            // Automatically route to closest verified clinic
            if (sortedSpots.length > 0) {
                drawOnScreenRoute(sortedSpots[0].name, sortedSpots[0].lat, sortedSpots[0].lng);
            }

            renderSpotCards(sortedSpots);
        }

        function renderSpotCards(spots) {
            const resultsList = document.getElementById('supportPointsList');
            resultsList.innerHTML = "";

            spots.forEach(spot => {
                const card = `
                    <div class="card support-card p-3 mb-3 shadow-sm">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge badge-free">🌸 Free Pads Verified</span>
                            <span class="fw-bold text-danger fs-6">🏃‍♀️ ${spot.walkTime}</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-1 mt-1">${escapeHtml(spot.name)}</h5>
                        <p class="text-muted small mb-2">📍 ${spot.distanceText} • ${escapeHtml(spot.details)}</p>
                        <div class="bg-white p-2 rounded border border-pink text-secondary small mb-2">
                            💡 <strong>Access Info:</strong> ${escapeHtml(spot.stock)}
                        </div>
                        <button onclick="drawOnScreenRoute('${escapeHtml(spot.name)}', ${spot.lat}, ${spot.lng})" class="btn btn-sm btn-danger fw-bold rounded-pill w-100">
                            🗺️ Show Route on Map Above
                        </button>
                    </div>
                `;
                resultsList.innerHTML += card;
            });
        }

        function drawOnScreenRoute(spotName, destLat, destLng) {
            recordSOSRequestForNGO(spotName);

            if (routingControl) {
                map.removeControl(routingControl);
            }

            routingControl = L.Routing.control({
                waypoints: [
                    L.latLng(userLat, userLng),
                    L.latLng(destLat, destLng)
                ],
                profile: 'mapbox/walking',
                router: L.Routing.osrmv1({
                    serviceUrl: 'https://router.project-osrm.org/route/v1'
                }),
                lineOptions: {
                    styles: [{ color: '#ff4d6d', opacity: 0.85, weight: 6 }]
                },
                createMarker: function() { return null; },
                addWaypoints: false,
                draggableWaypoints: false,
                fitSelectedRoutes: true
            }).addTo(map);

            document.getElementById('mapContainer').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function recordSOSRequestForNGO(areaName) {
            const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            const formData = new FormData();
            formData.append('locationArea', areaName);
            formData.append('urgencyLevel', 'Immediate');

            fetch('/Emergency/SubmitSOS', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': csrfToken
                },
                body: formData
            }).catch(error => {
                console.error("SOS record background sync failed:", error);
            });
        }

        function calculateDistanceMeters(lat1, lon1, lat2, lon2) {
            const R = 6371e3;
            const φ1 = lat1 * Math.PI / 180;
            const φ2 = lat2 * Math.PI / 180;
            const Δφ = (lat2 - lat1) * Math.PI / 180;
            const Δλ = (lon2 - lon1) * Math.PI / 180;

            const a = Math.sin(Δφ / 2) * Math.sin(Δφ / 2) +
                      Math.cos(φ1) * Math.cos(φ2) *
                      Math.sin(Δλ / 2) * Math.sin(Δλ / 2);

            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            return R * c;
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }
    </script>
}