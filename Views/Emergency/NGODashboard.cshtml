@model IEnumerable<FreeFlow.Controllers.NGOAreaInsightViewModel>

@{
    ViewData["Title"] = "NGO Pad Donation Prioritization Dashboard";
    var totalInterestCount = ViewBag.TotalSOSCount ?? 0;
}

<div class="container my-4">
    <!-- Header Banner -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <span class="badge bg-primary rounded-pill px-3 py-2 mb-2">🎯 Donation Planning &amp; Priority Engine</span>
                <h2 class="fw-bold text-dark mb-1">Pad Donation Target Heatmap</h2>
                <p class="text-muted mb-0">
                    Calculates community need based on search activity to tell your NGO <strong>where to send pad donations next</strong> and <strong>how much stock to allocate</strong>.
                </p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <div class="p-3 bg-light rounded-3 text-center border">
                    <span class="d-block text-muted small fw-bold">TOTAL SEARCH DEMAND LOGS</span>
                    <span class="fs-2 fw-bold text-primary">@totalInterestCount</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Targeted Area Priority Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom border-light d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">📍 Area Donation Priority Ranking</h5>
            <span class="badge bg-danger">Highest Need First</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Target Area / Community</th>
                        <th class="text-center">Donation Priority</th>
                        <th class="text-center">Recommended Stock Share</th>
                        <th class="text-center">Total Search Volume</th>
                        <th>Last Search Activity</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No demand data recorded yet. As community members search for pads, priority scores will calculate automatically.
                            </td>
                        </tr>
                    }
                    else
                    {
                        // Sort by highest demand search count so highest-need areas stay on top
                        var sortedList = Model.OrderByDescending(m => m.TotalPadsNeeded);

                        @foreach (var item in sortedList)
                        {
                            // Calculate percentage of upcoming donation inventory to allocate
                            double donationSharePct = totalInterestCount > 0 ? ((double)item.TotalPadsNeeded / (int)totalInterestCount) * 100 : 0;

                            <tr>
                                <td class="fw-bold text-dark">
                                    📍 @item.LocationArea
                                </td>
                                <td class="text-center">
                                    @if (donationSharePct >= 35.0 || item.TotalPadsNeeded > 20)
                                    {
                                        <span class="badge bg-danger fs-6 px-3 py-2">🔥 #1 Top Priority Drop Zone</span>
                                    }
                                    else if (donationSharePct >= 15.0 || item.TotalPadsNeeded > 5)
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2">⚠️ High Allocation Need</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2">Standard Allocation</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="fs-5 fw-bold text-primary">@donationSharePct.ToString("F1")%</span>
                                    <div class="text-muted small">of next donation batch</div>
                                </td>
                                <td class="text-center fs-5 fw-bold text-dark">
                                    @item.TotalPadsNeeded <span class="fs-6 fw-normal text-muted">searches</span>
                                </td>
                                <td class="small text-muted">
                                    @item.LastRequested.ToString("MMM dd, yyyy - HH:mm")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>